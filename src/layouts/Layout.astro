---
import ThemeProvider from '../components/ThemeProvider.astro';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Abingdon Antiques - Your Premier Source for Fine Antiques" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
		<!-- Apply saved theme before first paint; default = dark unless user chose light -->
		<script is:inline>
			try {
				var s = localStorage.getItem('theme');
				if (s === 'light') document.documentElement.classList.remove('dark');
				else document.documentElement.classList.add('dark');
			} catch (_) {
				document.documentElement.classList.add('dark');
			}
		</script>
		<ClientRouter />
		<Analytics />
	</head>
	<body class="antiques-body">
		<ThemeProvider>
			<slot />
		</ThemeProvider>
	</body>
</html>

<style is:global>
/* Abingdon Antiques – modern heritage */
*,
*::before,
*::after {
  box-sizing: border-box;
}
html {
  overflow-x: hidden;
  overflow-x: clip;
  overflow-y: auto;
}
body.antiques-body {
  overflow-x: hidden;
  overflow-x: clip;
}
body.antiques-body > * {
  min-width: 0;
  max-width: 100%;
  overflow-x: clip;
}
:root {
  --font-sans: 'Inter', system-ui, sans-serif;
  --font-serif: 'Fraunces', 'Iowan Old Style', Georgia, serif;
  --primary: #a4762e;
  --primary-light: #b8893e;
  --secondary: #6b7a5a;
  --accent: #c4a574;
  --cream: #f7f2ea;
  --cream-dark: #efe8dc;
  --ink: #26201a;
  --ink-muted: #6b6158;
  --card-bg: #fbf8f2;
  --card-border: #d9cfc0;
  --brass: #a4762e;
  --shadow: 0 1px 0 rgba(38, 32, 26, 0.04);
  --shadow-hover: 0 8px 24px rgba(38, 32, 26, 0.08);
  --radius: 2px;
  --radius-lg: 4px;
  --transition: 0.2s ease;
}
html.dark {
  --primary: #c9a05a;
  --primary-light: #d4b06e;
  --secondary: #8a9a78;
  --accent: #e0c48a;
  --cream: #1c1814;
  --cream-dark: #151210;
  --ink: #f3ece3;
  --ink-muted: #b8aea2;
  --card-bg: #241f1a;
  --card-border: #3d352c;
  --brass: #c9a05a;
  --shadow: 0 1px 0 rgba(0, 0, 0, 0.2);
  --shadow-hover: 0 8px 24px rgba(0, 0, 0, 0.35);
}
html {
  font-family: var(--font-sans);
  background: var(--cream);
  color: var(--ink);
  transition: background-color var(--transition), color var(--transition);
  scroll-behavior: smooth;
}
html::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.055'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 0;
}
html.dark::before {
  opacity: 0.7;
}
body.antiques-body {
  margin: 0;
  min-height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
}

/* ----- Skip link ----- */
.skip-link {
  position: absolute;
  top: -100px;
  left: 1rem;
  z-index: 100;
  padding: 0.75rem 1rem;
  background: var(--primary);
  color: var(--cream);
  border-radius: var(--radius);
  text-decoration: none;
  font-weight: 600;
  font-size: 0.8125rem;
  letter-spacing: 0.04em;
  transition: top 0.2s ease;
}
.skip-link:focus {
  top: 1rem;
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

/* ----- Announcement ----- */
.announcement-bar {
  width: 100%;
  max-width: 100%;
  background: var(--cream-dark);
  border-bottom: 1px solid var(--card-border);
  border-left: 4px solid var(--primary);
  box-sizing: border-box;
}
.announcement-inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 0.75rem 1.25rem;
  max-width: 72rem;
  width: 100%;
  margin: 0 auto;
  padding: 1.15rem 1.5rem;
  box-sizing: border-box;
  text-align: center;
}
.announcement-label {
  font-family: var(--font-sans);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--cream);
  background: var(--primary);
  padding: 0.4rem 0.75rem;
  border-radius: var(--radius);
  flex-shrink: 0;
}
.announcement-text {
  margin: 0;
  font-size: 1.0625rem;
  line-height: 1.55;
  color: var(--ink);
}
.announcement-text strong {
  font-family: var(--font-serif);
  font-optical-sizing: auto;
  font-weight: 600;
  font-size: 1.15em;
}
.announcement-sep {
  margin: 0 0.5rem;
  color: var(--card-border);
}
.announcement-address {
  color: var(--primary);
  text-decoration: none;
  font-weight: 500;
  white-space: nowrap;
  transition: color var(--transition);
}
.announcement-address:hover {
  color: var(--primary-light);
  text-decoration: underline;
  text-underline-offset: 0.15em;
}
.announcement-note {
  color: var(--ink-muted);
  font-size: 0.9375rem;
  font-style: italic;
}
@media (max-width: 640px) {
  .announcement-sep {
    display: none;
  }
  .announcement-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }
  .announcement-address {
    white-space: normal;
  }
}

/* ----- Masthead ----- */
.site-header {
  width: 100%;
  max-width: 100%;
  background: var(--cream);
  border-bottom: 1px solid var(--card-border);
  box-shadow: 0 2px 0 var(--cream), 0 3px 0 var(--card-border);
  transition: background-color var(--transition), border-color var(--transition);
}
.masthead-bar {
  border-bottom: 1px solid var(--card-border);
}
.masthead-bar-inner {
  display: flex;
  align-items: center;
  gap: 1rem;
  max-width: 72rem;
  width: 100%;
  margin: 0 auto;
  padding: 0.45rem 1.25rem;
  box-sizing: border-box;
}
.masthead-link {
  font-size: 0.6875rem;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ink-muted);
  text-decoration: none;
  transition: color var(--transition);
  white-space: nowrap;
}
.masthead-link:hover {
  color: var(--primary);
}
.masthead-address {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}
.masthead-phone {
  margin-left: auto;
}
@media (max-width: 640px) {
  .masthead-address {
    display: none;
  }
  .masthead-phone {
    margin-left: 0;
  }
}
.theme-toggle-wrap {
  position: static;
  margin-left: 0.25rem;
  flex-shrink: 0;
}
.theme-toggle {
  cursor: pointer;
  padding: 0.35rem;
  color: var(--ink-muted);
  background: transparent;
  border: 1px solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: color var(--transition), border-color var(--transition);
  border-radius: var(--radius);
}
.theme-toggle:hover {
  color: var(--primary);
  border-color: var(--card-border);
}
.theme-icon {
  width: 1.1rem;
  height: 1.1rem;
  display: block;
}
.theme-icon-hidden {
  display: none !important;
}
.header-inner {
  max-width: 72rem;
  width: 100%;
  min-width: 0;
  margin: 0 auto;
  padding: 0 1.25rem;
  box-sizing: border-box;
}
.logo-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1.5rem;
  padding: 1.35rem 0 1.5rem;
}
.logo-rule {
  flex: 1;
  max-width: 7.5rem;
  height: 1px;
  background: var(--card-border);
}
.logo-wrap .logo-img {
  max-width: 180px;
  height: auto;
  object-fit: contain;
  border-radius: 0;
  border: none;
  box-shadow: none;
}
@media (min-width: 768px) {
  .logo-wrap .logo-img {
    max-width: 280px;
  }
}

/* ----- Layout ----- */
.main-content {
  flex: 1;
  min-width: 0;
  width: 100%;
  max-width: 100%;
  padding: 0 1rem 4rem;
}
.container {
  max-width: 60rem;
  width: 100%;
  min-width: 0;
  margin: 0 auto;
  padding: 0 1rem;
}

/* ----- Type ----- */
.eyebrow {
  font-family: var(--font-sans);
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--primary);
  margin: 0 0 0.85rem;
  text-align: center;
}
.section-head {
  text-align: center;
  margin-bottom: 2rem;
}
.section-title {
  font-family: var(--font-serif);
  font-optical-sizing: auto;
  font-size: clamp(1.75rem, 3.2vw, 2.35rem);
  font-weight: 500;
  font-variation-settings: "SOFT" 40, "WONK" 1;
  text-align: center;
  color: var(--ink);
  margin: 0;
  letter-spacing: -0.01em;
  line-height: 1.2;
}
.ornament {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.7rem;
  margin: 1rem auto 0;
  color: var(--primary);
  font-size: 0.55rem;
  line-height: 1;
}
.ornament::before,
.ornament::after {
  content: '';
  width: 2.25rem;
  height: 1px;
  background: var(--primary);
  opacity: 0.45;
}

/* ----- Hero ----- */
.hero {
  padding: 3.25rem 0 2.5rem;
  position: relative;
}
.hero-headline {
  font-family: var(--font-serif);
  font-optical-sizing: auto;
  font-weight: 400;
  font-size: clamp(2.15rem, 6.2vw, 3.85rem);
  font-variation-settings: "SOFT" 50, "WONK" 1;
  line-height: 1.12;
  text-align: center;
  margin: 0 0 1.15rem;
  color: var(--ink);
  letter-spacing: -0.02em;
}
.hero-text {
  font-size: 1.0625rem;
  color: var(--ink-muted);
  text-align: center;
  margin: 0 auto 1.85rem;
  line-height: 1.7;
  letter-spacing: 0.01em;
  max-width: 36rem;
}
.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.85rem;
  justify-content: center;
  align-items: center;
}
.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.85rem 1.45rem;
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  text-decoration: none;
  transition: background var(--transition), color var(--transition), border-color var(--transition), transform var(--transition);
  border: 1px solid transparent;
  cursor: pointer;
}
.btn-icon {
  width: 1.05rem;
  height: 1.05rem;
  flex-shrink: 0;
}
.btn-map {
  background: var(--primary);
  color: #f7f2ea;
  border-color: var(--primary);
}
.btn-map:hover {
  background: var(--primary-light);
  border-color: var(--primary-light);
  transform: translateY(-1px);
}
.btn-phone {
  background: transparent;
  color: var(--ink);
  border-color: var(--ink);
}
.btn-phone:hover {
  background: var(--ink);
  color: var(--cream);
  transform: translateY(-1px);
}

/* ----- Carousel ----- */
.carousel-section {
  padding: 2.5rem 0 3rem;
}
.carousel-wrapper {
  position: relative;
  min-width: 0;
  padding: 8px 8px 0;
}
.carousel-stage {
  position: relative;
}
.carousel-frame {
  padding: 0.7rem;
  background: var(--cream-dark);
  border: 1px solid var(--card-border);
  box-shadow: 0 0 0 5px var(--cream), 0 0 0 6px var(--card-border);
}
.carousel {
  overflow: hidden;
  border-radius: 0;
  box-shadow: none;
  background: var(--cream-dark);
  width: 100%;
  max-width: 100%;
  border: 1px solid var(--card-border);
}
.carousel-track {
  display: flex;
  transition: transform 0.3s ease-in-out;
  min-width: 0;
}
.carousel-slide {
  min-width: 100%;
  width: 100%;
  flex-shrink: 0;
}
.carousel-img {
  width: 100%;
  max-width: 100%;
  height: 17rem;
  object-fit: cover;
  cursor: pointer;
  transition: opacity var(--transition);
  display: block;
  backface-visibility: hidden;
}
.carousel-img:hover {
  opacity: 0.92;
}
@media (min-width: 768px) {
  .carousel-img {
    height: 26rem;
  }
}
.carousel-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 2.4rem;
  height: 2.4rem;
  border-radius: var(--radius);
  border: 1px solid var(--card-border);
  background: var(--cream);
  color: var(--ink);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background var(--transition), color var(--transition), border-color var(--transition);
  z-index: 2;
}
.carousel-nav:hover {
  background: var(--primary);
  color: #f7f2ea;
  border-color: var(--primary);
}
.carousel-prev {
  left: 0.85rem;
}
.carousel-next {
  right: 0.85rem;
}
.carousel-nav-icon {
  width: 1.25rem;
  height: 1.25rem;
  stroke-width: 1.5;
}
.carousel-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1.25rem;
  margin-top: 1.35rem;
  flex-wrap: wrap;
}
.carousel-counter {
  font-family: var(--font-serif);
  font-optical-sizing: auto;
  font-size: 0.95rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  color: var(--ink-muted);
  font-variant-numeric: tabular-nums;
}
.carousel-indicators {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 0.4rem;
  margin-top: 0;
}
.carousel-dot {
  width: 1.6rem;
  height: 1.35rem;
  border-radius: 0;
  border: none;
  background: transparent;
  cursor: pointer;
  padding: 0;
  position: relative;
}
.carousel-dot::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 2px;
  background: var(--card-border);
  transform: translateY(-50%);
  transition: background var(--transition), left var(--transition), right var(--transition);
}
.carousel-dot:hover::after {
  background: var(--ink-muted);
}
.carousel-dot[aria-selected="true"] {
  width: 2.15rem;
  background: transparent;
}
.carousel-dot[aria-selected="true"]::after {
  background: var(--primary);
}

/* ----- Lightbox ----- */
.lightbox {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(20, 16, 12, 0.92);
}
.lightbox.hidden {
  display: none !important;
}
.lightbox-inner {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.lightbox-img {
  max-width: 100%;
  max-height: 90vh;
  object-fit: contain;
}
.lightbox-btn {
  position: absolute;
  background: transparent;
  border: none;
  color: #fff;
  font-size: 2rem;
  padding: 0.5rem;
  cursor: pointer;
  z-index: 2;
  transition: background var(--transition), color var(--transition);
  border-radius: var(--radius);
}
.lightbox-btn:hover {
  background: rgba(255, 255, 255, 0.12);
  color: var(--accent);
}
.lightbox-close {
  top: 1rem;
  right: 1rem;
  font-size: 2.5rem;
  line-height: 1;
}
.lightbox-prev {
  left: 1rem;
  top: 50%;
  transform: translateY(-50%);
}
.lightbox-next {
  right: 1rem;
  top: 50%;
  transform: translateY(-50%);
}
.lightbox-counter {
  position: absolute;
  bottom: 1.25rem;
  left: 50%;
  transform: translateX(-50%);
  color: #f3ece3;
  font-family: var(--font-serif);
  font-size: 0.95rem;
  letter-spacing: 0.08em;
  background: transparent;
  padding: 0;
  border-radius: 0;
}

/* ----- Info cards ----- */
.info-section {
  padding: 2.5rem 0;
}
.info-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
}
@media (min-width: 768px) {
  .info-grid {
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
}
.info-card {
  background: var(--card-bg);
  border: 1px solid var(--card-border);
  border-radius: var(--radius-lg);
  padding: 1.65rem 1.5rem 1.5rem;
  box-shadow: none;
  transition: border-color var(--transition);
}
.info-card:hover {
  box-shadow: none;
  border-color: var(--accent);
}
.info-card-title {
  font-family: var(--font-sans);
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--ink);
  margin: 0 0 1.25rem;
  padding-bottom: 0.7rem;
  border-bottom: 1px solid var(--primary);
  display: inline-block;
}
.info-card-body {
  color: var(--ink-muted);
  font-size: 0.9375rem;
  line-height: 1.65;
}
.info-card-body p + p {
  margin-top: 1rem;
}
.info-card-body a {
  color: var(--primary);
  text-decoration: none;
  transition: color var(--transition);
  word-break: break-word;
  overflow-wrap: break-word;
}
.info-card-body a:hover {
  color: var(--primary-light);
  text-decoration: underline;
  text-underline-offset: 0.15em;
}
.hours-row {
  display: flex;
  align-items: baseline;
  gap: 0.6rem;
  margin-bottom: 0.85rem;
}
.hours-days {
  font-weight: 500;
  color: var(--ink);
  flex-shrink: 0;
}
.hours-leader {
  flex: 1;
  border-bottom: 1px dotted var(--card-border);
  min-width: 1rem;
  transform: translateY(-0.28em);
}
.hours-time {
  color: var(--ink-muted);
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}
.hours-note {
  margin-top: 1.1rem;
  padding: 0.7rem 0.85rem;
  background: transparent;
  border: 1px solid var(--card-border);
  border-radius: var(--radius);
}
.hours-note p {
  margin: 0;
  font-size: 0.8125rem;
  color: var(--ink-muted);
}
html.dark .hours-note {
  background: transparent;
}

/* ----- About ----- */
.about-section {
  padding: 2.75rem 0;
}
.about-inner {
  text-align: center;
}
.about-lead {
  font-family: var(--font-serif);
  font-optical-sizing: auto;
  font-size: clamp(1.15rem, 2.2vw, 1.4rem);
  font-weight: 400;
  font-variation-settings: "SOFT" 30, "WONK" 0;
  color: var(--ink);
  line-height: 1.55;
  margin: 0 auto 1.15rem;
  max-width: min(40rem, 100%);
}
.about-text {
  color: var(--ink-muted);
  line-height: 1.75;
  margin: 0 auto 1.75rem;
  max-width: min(40rem, 100%);
}
.vendor-cta {
  display: inline-block;
  max-width: 100%;
  background: var(--card-bg);
  border: 1px solid var(--card-border);
  border-left: 3px solid var(--primary);
  border-radius: var(--radius);
  padding: 1.1rem 1.5rem;
  box-shadow: none;
  text-align: left;
}
.vendor-cta p {
  margin: 0;
  color: var(--ink);
  font-size: 0.9375rem;
  word-wrap: break-word;
  overflow-wrap: break-word;
  line-height: 1.6;
}
.vendor-cta a {
  color: var(--primary);
  text-decoration: none;
}
.vendor-cta a:hover {
  text-decoration: underline;
  text-underline-offset: 0.15em;
}

/* ----- Map ----- */
.map-section {
  padding: 2.5rem 8px 1.5rem;
}
.map-wrap {
  padding: 0.6rem;
  border-radius: 0;
  overflow: hidden;
