---
import { Image } from 'astro:assets';
import ThemeToggle from "./ThemeToggle.astro";
import AddressLink from "./AddressLink.astro";
---

<header class="site-header" role="banner">
  <div class="masthead-bar">
    <div class="masthead-bar-inner">
      <AddressLink class="masthead-link masthead-address">227 W Main St, Abingdon, VA</AddressLink>
      <a href="tel:276-477-1515" class="masthead-link masthead-phone">276-477-1515</a>
      <div class="theme-toggle-wrap">
        <ThemeToggle />
      </div>
    </div>
  </div>
  <div class="header-inner">
    <div class="logo-wrap">
      <span class="logo-rule" aria-hidden="true"></span>
      <Image
        src="/images/logo.webp"
        alt="Abingdon Antiques and More"
        width={360}
        height={105}
        class="logo-img"
        loading="eager"
        decoding="async"
      />
      <span class="logo-rule" aria-hidden="true"></span>
    </div>
  </div>
</header>
